# دفتر فاکتور — تنظیمات امنیتی
Options -Indexes
DirectoryIndex index.php

# app.html فقط از طریق index.php (بعد از ورود) نمایش داده می‌شود
<FilesMatch "^(app\.html|php\.ini|\.user\.ini|\.ftpquota|.*\.(md|txt|json|lock|log|bak|ini|yml|sh))$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# آیکون‌ها و فایل نصب روی صفحه‌ی اصلی گوشی
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/x-icon .ico
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/x-icon "access plus 7 days"
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType font/woff2 "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
</IfModule>

# برای اجبار به https (اگر گواهی SSL دارید) سه خط زیر را از حالت توضیح خارج کنید:
# RewriteEngine On
# RewriteCond %{HTTPS} !=on
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
